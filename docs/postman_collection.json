{
  "info": {
    "name": "PlayArena Sports Ground Booking API",
    "description": "Comprehensive Postman API Collection for PlayArena Sports Ground Booking and Management System (Kalvium Micro Project)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "description": "Health check endpoint returning service status and uptime"
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Harsha Vardhan Reddy\",\n  \"email\": \"user@playarena.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"+91 9123456789\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@playarena.com\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@playarena.com\",\n  \"password\": \"AdminPass123!\"\n}"
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/auth/profile",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Harsha Vardhan Reddy Updated\",\n  \"phone\": \"+91 9988776655\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Grounds",
      "item": [
        {
          "name": "List Grounds (Filter, Search, Paginate)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/grounds?sportType=Football&city=Bangalore&page=1&limit=9&sortBy=hourlyPrice&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["grounds"],
              "query": [
                { "key": "sportType", "value": "Football" },
                { "key": "city", "value": "Bangalore" },
                { "key": "search", "value": "Turf", "disabled": true },
                { "key": "minPrice", "value": "500", "disabled": true },
                { "key": "maxPrice", "value": "2000", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "9" },
                { "key": "sortBy", "value": "hourlyPrice" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get Ground Details by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/grounds/1"
          }
        },
        {
          "name": "Get Ground Slots by Date",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/grounds/1/slots?date=2026-10-25",
              "host": ["{{baseUrl}}"],
              "path": ["grounds", "1", "slots"],
              "query": [{ "key": "date", "value": "2026-10-25" }]
            }
          }
        },
        {
          "name": "Admin: Create Ground",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/grounds",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Champions Cricket Arena\",\n  \"sportType\": \"Cricket\",\n  \"description\": \"State-of-the-art practice nets with automated bowling machines and floodlights.\",\n  \"location\": \"Electronic City Phase 1\",\n  \"city\": \"Bangalore\",\n  \"hourlyPrice\": 1400.00,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1531415074968-036ba1b575da\",\n  \"facilities\": [\"Bowling Machine\", \"Floodlights\", \"Pavilion\", \"Parking\"]\n}"
            }
          }
        },
        {
          "name": "Admin: Update Ground",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/grounds/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hourlyPrice\": 1550.00,\n  \"description\": \"Updated description with enhanced amenities.\"\n}"
            }
          }
        },
        {
          "name": "Admin: Deactivate Ground",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/grounds/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Slots Management",
      "item": [
        {
          "name": "Admin: Create Single Slot",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/slots",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groundId\": 1,\n  \"date\": \"2026-10-26\",\n  \"startTime\": \"21:00\",\n  \"endTime\": \"22:00\",\n  \"price\": 1500.00\n}"
            }
          }
        },
        {
          "name": "Admin: Batch Generate Slots",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/slots/batch",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groundId\": 1,\n  \"startDate\": \"2026-10-27\",\n  \"days\": 3,\n  \"slotTimes\": [\n    { \"startTime\": \"06:00\", \"endTime\": \"07:00\" },\n    { \"startTime\": \"07:00\", \"endTime\": \"08:00\" },\n    { \"startTime\": \"18:00\", \"endTime\": \"19:00\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Admin: Delete Slot",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/slots/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking (Concurrency Protected)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": 25,\n  \"notes\": \"Weekend friendly match with office colleagues\"\n}"
            }
          }
        },
        {
          "name": "List Bookings (User History / Admin Filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/bookings?status=CONFIRMED&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"],
              "query": [
                { "key": "status", "value": "CONFIRMED" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bookings/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "Cancel Booking (Owner or Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/bookings/1/cancel",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Rescheduling due to unexpected conflict\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Analytics & Dashboard",
      "item": [
        {
          "name": "Admin Dashboard Analytics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/analytics/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    }
  ]
}
